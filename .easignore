# .easignore — controls what gets uploaded to EAS Build.
# When this file exists it REPLACES .gitignore for EAS, so it must
# repeat the .gitignore entries plus the extra excludes below.

# --- from .gitignore ---
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
/ios
/android

# --- not needed for the mobile APK build ---
admin/
website/
supabase/
BUILD_PLAN.md
.claude/
.git/
**/.next/
**/*.png.orig
