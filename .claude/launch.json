{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "MiniGreens Admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 4001,
      "cwd": "admin"
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
